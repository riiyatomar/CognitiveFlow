# ===================================================================
# CognitiveFlow - Production & Development Environment Variables
# Copy this file to .env and configure real credentials.
# DO NOT COMMIT REAL CREDS/KEYS TO VERSION CONTROL.
# ===================================================================

# Database Connection (Neon / Managed PostgreSQL connection string with SSL)
DATABASE_URL=postgres://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Node Environment ('production' or 'development')
NODE_ENV=production

# Server Port (Render/Railway/Heroku automatically populates PORT)
PORT=5000

# Express Session Secret (Must be a secure random 32+ character string in production)
SESSION_SECRET=a_very_secure_random_session_secret_change_me_in_prod_32chars

# Google Gemini API Credentials (Server-side ONLY - Never expose to client)
GEMINI_API_KEY=AIzaSySampleGeminiApiKeyStringHere
GEMINI_MODEL=gemini-3.5-flash
